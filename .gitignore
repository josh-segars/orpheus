.DS_Store
Thumbs.db
*.log
node_modules/

# Environment variables — never commit
.env
.env.local
.env.*.local

# Client data — contains private LinkedIn data, never commit
client-data/

# Python
__pycache__/
*.pyc

# Supabase CLI local artifacts (do not commit).
# supabase/config.toml and supabase/migrations/ are kept in-repo;
# everything else is per-developer machine state.
supabase/.branches/
supabase/.temp/
supabase/.env
# TypeScript incremental build cache — per-machine, never commit.
*.tsbuildinfo
# Supabase Studio per-developer SQL snippet state.
supabase/snippets/
LinkedIn_API_Terms_Review_*.docx

# Compliance drafts — stay untracked pending Tim's review and a
# separate commit-vs-Drive decision. Adopted 2026-05-29 after a
# `git add -A` sweep accidentally bundled drafts into a ship commit
# (recovered via force-push). Add new draft variants here as they appear.
LinkedIn_BD_DPA_Review_*.md
Orpheus_Privacy_Policy_DRAFT_*.md
Orpheus_Privacy_Policy_DRAFT_*.docx
Orpheus_Terms_of_Service_DRAFT_*.md
Orpheus_Terms_of_Service_DRAFT_*.docx

# Signal Score brainstorm / reference snapshots — stay untracked.
# These are working scratchpads that capture current-state references
# for framework design conversations; the canon lives elsewhere.
Signal_Score_Dimensions_Reference_*.md

# Vite production build output + HMR timestamp files — generated, never commit.
frontend/dist/
frontend/vite.config.ts.timestamp-*.mjs

# Working scratchpads, experiment output, and per-developer state —
# untracked by intent. Rationale lives in the rolling SESSION_HANDOFF;
# enforced here so `git add -A` cannot sweep them in. It did once
# (2026-05-29, recovered via force-push) and orpheus-session-wrap's
# step 7 still instructs `git add -A`, so memory is not a sufficient
# guard. Patterns checked against `git ls-files` for zero clashes with
# tracked files — Decision_*, Spec_* and ORPHEUS-96_repro_* stay tracked.
Draft_*.md
Scoping_*.md
Survey_*.md
ORPHEUS-*_Decision_Brief_*.md
rubric_consistency_results_*.json
create_beta_survey_form.gs
outputs/
.claude/settings.local.json
# Acceptance-sweep text dumps (backend/scripts/claims_sweep.py) and the
# pre-write snapshots regenerate_report.py drops at the repo root. Both
# contain client narrative text verbatim, so neither may ever reach a
# commit. regenerate_report.py has described its snapshots as "untracked
# by default" since ORPHEUS-112 but nothing enforced it until now.
sweep_*/
snapshot_*.json

# Session-transfer scratch: files staged for manual deletion (the device
# bridge cannot unlink; deletions become moves into this folder).
_to_delete/
